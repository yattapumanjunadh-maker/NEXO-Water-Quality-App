<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXO" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/nexo_blue"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Quality Screening" android:textSize="16sp" android:textColor="@color/nexo_muted"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:id="@+id/offlineBadge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="●  OFFLINE READY" android:textStyle="bold" android:textColor="@color/nexo_teal" android:textSize="14sp" android:padding="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/languageButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Language: English" android:textAllCaps="false" android:textSize="13sp" android:minHeight="44dp" android:paddingStart="6dp" android:paddingEnd="6dp" app:cornerRadius="14dp" android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Field Screening Dashboard" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/nexo_text" android:layout_marginTop="30dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture, analyse and map water-quality observations." android:textSize="16sp" android:textColor="@color/nexo_muted" android:layout_marginTop="5dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="22dp">
<TextView android:id="@+id/sampleCount" android:layout_width="0dp" android:layout_height="115dp" android:layout_weight="1" android:text="SAMPLES&#10;0" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/nexo_text" android:gravity="center_vertical" android:padding="20dp" android:background="@drawable/card_bg"/>
<Space android:layout_width="12dp" android:layout_height="1dp"/>
<TextView android:id="@+id/lastResult" android:layout_width="0dp" android:layout_height="115dp" android:layout_weight="1" android:text="LAST RESULT&#10;—" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/nexo_text" android:gravity="center_vertical" android:padding="20dp" android:background="@drawable/card_bg"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/startTestButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="START NEW WATER TEST" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" android:layout_marginTop="20dp" app:cornerRadius="14dp" app:backgroundTint="@color/nexo_blue"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="How NEXO works" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/nexo_text" android:layout_marginTop="25dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/howSteps" android:text="1  Select intended water use&#10;&#10;2  Perform the appropriate field test&#10;&#10;3  Scan the reacted test strip&#10;&#10;4  Computer vision reads the colour response&#10;&#10;5  Calibration converts colour to the test-specific value&#10;&#10;6  Compare with applicable screening criterion&#10;&#10;7  Store GPS, time and sample ID" android:textSize="16sp" android:lineSpacingExtra="5dp" android:textColor="@color/nexo_text" android:padding="20dp" android:layout_marginTop="10dp" android:background="@drawable/card_bg"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/importantText" android:text="IMPORTANT&#10;&#10;NEXO is a field screening tool. It reports only parameters actually measured by the selected test. A screening result is not a certified laboratory determination." android:textSize="14sp" android:textColor="@color/warning_text" android:padding="18dp" android:layout_marginTop="18dp" android:background="@drawable/warning_bg"/>
</LinearLayout></ScrollView>