<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New Water Test" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/nexo_text"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose the intended use and the test you are performing." android:textSize="16sp" android:textColor="@color/nexo_muted" android:layout_marginTop="5dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INTENDED WATER USE" android:textStyle="bold" android:textColor="@color/nexo_muted" android:layout_marginTop="25dp"/>
<Spinner android:id="@+id/useSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PARAMETER / TEST" android:textStyle="bold" android:textColor="@color/nexo_muted" android:layout_marginTop="20dp"/>
<Spinner android:id="@+id/parameterSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp"/>
<TextView android:id="@+id/testProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEST 1 OF 1" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/nexo_blue_dark" android:padding="15dp" android:layout_marginTop="12dp" android:background="@drawable/card_bg"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUMBER OF TESTS (1–5)" android:textStyle="bold" android:textColor="@color/nexo_muted" android:layout_marginTop="18dp"/>
<Spinner android:id="@+id/testCountSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp"/>
<TextView android:id="@+id/criterionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configured screening criterion: —" android:textSize="14sp" android:textColor="@color/nexo_blue_dark" android:padding="15dp" android:layout_marginTop="12dp" android:background="@drawable/card_bg"/>
<TextView android:id="@+id/referenceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CALIBRATION REFERENCE" android:textStyle="bold" android:textColor="@color/nexo_muted" android:layout_marginTop="18dp"/>
<HorizontalScrollView android:id="@+id/referenceScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:id="@+id/referenceContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp"/>
</HorizontalScrollView>
<com.google.android.material.button.MaterialButton android:id="@+id/allReferenceButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="VIEW ALL 7 REFERENCE CHARTS" android:textAllCaps="false" android:textStyle="bold" android:layout_marginTop="8dp" app:cornerRadius="12dp"/>
<TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prepare the selected test according to the manufacturer's instructions. Scan after the specified reaction time." android:textSize="15sp" android:textColor="@color/nexo_text" android:padding="18dp" android:layout_marginTop="12dp" android:background="@drawable/card_bg"/>
<com.google.android.material.button.MaterialButton android:id="@+id/cameraButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="OPEN CAMERA &amp; SCAN" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="18dp" app:cornerRadius="14dp" app:backgroundTint="@color/nexo_blue"/>
<ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="15dp" android:scaleType="centerInside" android:background="@color/white" android:contentDescription="Test strip preview"/>
<TextView android:id="@+id/colourReadout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Computer vision: —" android:textSize="14sp" android:textColor="@color/nexo_muted" android:layout_marginTop="10dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/resultButton" android:layout_width="match_parent" android:layout_height="55dp" android:text="VIEW SCREENING RESULT" android:enabled="false" android:layout_marginTop="10dp" app:cornerRadius="14dp"/>
</LinearLayout></ScrollView>